# Supabase — Project Settings > API in the Supabase dashboard.
# Both of these are safe to expose in the browser: the anon key grants nothing
# on its own, because row-level security decides what each signed-in user can
# reach. NEVER put the service_role key in this file or anywhere in this app.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The public origin used to build shareable invite links. This app is a static
# bundle (no server), so it must be set at build time for anything other than
# local dev — inside the native shell window.location.origin is a private
# scheme no one else can open. Locally, use http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://splitledger.example.com
