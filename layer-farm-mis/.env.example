# ---------------------------------------------------------------------------
# Layer Farm MIS runs WITHOUT any of these. The device database is the source
# of truth and every screen works offline. Fill these in only when you want
# several phones on one farm to share data through the cloud.
# ---------------------------------------------------------------------------

# Supabase — Project Settings > API. Both values are safe in the app bundle:
# the anon key grants nothing on its own, row-level security decides what each
# signed-in user can reach. NEVER ship the service_role key; it bypasses RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public origin, used for magic-link sign-in redirects. Inside the native shell
# window.location.origin is a private scheme nobody can open, so set this at
# build time for a real deployment.
NEXT_PUBLIC_SITE_URL=
